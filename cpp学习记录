//值传递
//定义函数，实现两个数字进行交换的函数
//如果一个函数不需要返回值，声明的时候可以写void
void swap(int num1, int num2)
{
	cout << "before swapping: " << endl;
	cout << "num1 = " << num1 << endl;
	cout << "num2 = " << num2 << endl;

	int temp = num1;
	num1 = num2;
	num2 = temp;

	cout << "after swapping: " << endl;
	cout << "num1 = " << num1 << endl;
	cout << "num2 = " << num2 << endl;

	//return;返回值不需要的时候可以不写return
}
