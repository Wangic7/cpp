#include<iostream>
using namespace std;
//结构体指针
//利用操作符->可以通过结构体指针访问结构体属性
struct student
{
	string name;
	int age;
	int score;
};
int main()
{
	//创建学生的结构体变量
	struct student s = { "Z",18,100 };//struct在此处可以省略

	//通过指针指向结构体变量
	student* p = &s;
	//通过指针访问结构体变量中的数据
	cout << "name: " << p->name << "age: " << p->age << "score: " << p->score << endl;
	system("pause");
	return 0;
}


#include<iostream>
using namespace std;

struct student
{
	string name;
	int age;
	int score;
};//定义结构体

//打印学生信息的函数
//1.值传递
void printStudent1(struct student s)
{
	s.age = 100;
	cout << "son of main:  name: " << s.name << "age: " << s.age << "score: " << s.score << endl;
}

//2。地址传递


void printStudent2(struct student * p)
{
	p->age = 200;
	cout << "son of main2 name:" << p->name << "age: " << p->age << "score: " << p->score << endl;
}
int main()
{
	//结构体做函数参数
	//将学生传入到一个参数中，打印学生身上的所有信息
	student s;//创建结构体变量
	s.name = "z";
	s.age = 18;
	s.score = 88;

	printStudent1(s);
	printStudent2(&s);
	cout << "main:   name:" << s.name << "age: " << s.age << "score: " << s.score << endl;

	system("pause");
	return 0;
}
！如果不想修改主函数中的数据，用值传递，反之用地址传递！
