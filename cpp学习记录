void printArray(int* arr, int len)
{
	for (int i = 0;i < len;i++)
	{
		cout << arr[i] << endl;
	}
}


int main()
{
	int arr[10] = { 4,3,6,9,1,2,10,8,7,5 };//创建数组

	int len = sizeof(arr) / sizeof(arr[0]);//数组长度
	bubbleSort(arr, len);//创建函数，实现冒泡排序
	printArray(arr, len);//打印排序后的数组

	system("pause");
	return 0;
}


