}


封装一个函数，利用冒泡排序，实现对整型数组的升序排序
案例数组int arr[10] = {4,3,6,9,1,2,10,8,7,5};

#include<iostream>
using namespace std;

//冒泡排序函数,参数一 数组的首地址 参数二 数组长度
void bubbleSort(int* arr,int len)
{
	for (int i = 0;i < len -  1;i++)
	{
		for (int j = 0;j < len - i - 1;j++)
		{
			if (arr[j] > arr[j + 1])
			{
				int temp = arr[j];
				arr[j] = arr[j + 1];
				arr[j + 1] = temp;
			}
		}
	}
}
